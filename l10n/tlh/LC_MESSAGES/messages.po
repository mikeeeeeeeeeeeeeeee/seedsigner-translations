# Klingon (tlhIngan Hol) translation for SeedSigner.
# Latin transliteration; the pIqaD script needs a font the device does not carry.
#
# Intentionally partial: 75 of 420 strings. Roots are attested in Marc Okrand's
# Klingon Dictionary; multi-word entries use canonical word-building (yI-
# imperative, -moH causative, -Ha' undo, -lIj your, -mey plural, -Daq locative,
# -qa' again). Untranslated strings fall back to English, which includes every
# security warning: Klingon has no vocabulary for "Native Segwit" or "derivation
# path", and inventing some on a bitcoin signing device would be worse than
# leaving it in English.
#
# Notable choices:
#   Settings -> SeHlaw   "control panel" (attested)
#   Seeds    -> tIrmey   tIr is "grain"; English "seed" is the same metaphor
#   Verify   -> yI'ol    'ol is "verify" (attested)
#   Advanced -> Qatlh    "be difficult"; no Klingon term for "advanced"
#   Skip     -> yIlIj    "forget it"
#
msgid ""
msgstr ""
"Project-Id-Version: seedsigner 0.8.7\n"
"Report-Msgid-Bugs-To: EMAIL@ADDRESS\n"
"Language: tlh\n"
"Language-Team: none\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=utf-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"

